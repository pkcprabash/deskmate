<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Deskmate.App.Controls.SpeechBubble"
             x:Name="Root">

    <Border Background="White"
            BorderBrush="#4A9C7A"
            BorderThickness="2"
            CornerRadius="12"
            Padding="12"
            MaxWidth="220">
        <StackPanel Spacing="8">
            <TextBlock Name="MessageText" TextWrapping="Wrap" FontSize="14" Foreground="#2C3E3A" />
            <StackPanel Name="ButtonsPanel"
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right">
                <Button Name="PrimaryButton" IsVisible="False" Click="OnPrimaryButtonClick" />
                <Button Name="SecondaryButton" IsVisible="False" Click="OnSecondaryButtonClick" />
            </StackPanel>
        </StackPanel>
    </Border>

</UserControl>

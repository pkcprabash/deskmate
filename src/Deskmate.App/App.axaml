<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Deskmate.App.App"
             xmlns:local="using:Deskmate.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/avalonia-logo.ico" ToolTipText="Deskmate">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Settings…" Click="OnTraySettingsClicked" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Pause for 1 hour" Click="OnTrayPauseHourClicked" />
                        <NativeMenuItem Header="Pause until tomorrow" Click="OnTrayPauseTomorrowClicked" />
                        <NativeMenuItem Header="Resume" Click="OnTrayResumeClicked" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Quit" Click="OnQuitClicked" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Deskmate.App.Views.FirstRunWindow"
        Title="Welcome to Deskmate"
        Width="380" Height="380"
        CanResize="False"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="20" Spacing="14">
        <TextBlock Text="Welcome to Deskmate!" FontSize="20" FontWeight="Bold" />
        <TextBlock TextWrapping="Wrap" Foreground="Gray"
                   Text="A quick setup before your new desk companion moves in." />

        <StackPanel Spacing="4">
            <TextBlock Text="What should Deskmate call you?" />
            <TextBox Name="UserNameTextBox" PlaceholderText="Your name" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Choose an avatar" />
            <ComboBox Name="AvatarPackComboBox" HorizontalAlignment="Stretch" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="What's its name?" />
            <TextBox Name="AvatarNameTextBox" PlaceholderText="Avatar's name" />
        </StackPanel>

        <CheckBox Name="StartAtLoginCheckBox" Content="Start Deskmate at login" IsChecked="True" />

        <Button Name="GetStartedButton" Content="Get started" HorizontalAlignment="Right" Click="OnGetStartedClicked" />
    </StackPanel>

</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Deskmate.App.Views.ChatWindow"
        Title="Chat"
        Width="360" Height="480"
        WindowStartupLocation="CenterScreen"
        KeyDown="OnWindowKeyDown">

    <DockPanel Margin="16">
        <TextBlock Name="UnavailableText"
                   DockPanel.Dock="Top"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"
                   IsVisible="False"
                   Text="Turn on AI messages in Settings and add your Anthropic API key to chat." />

        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0" ColumnDefinitions="*,Auto,Auto">
            <TextBox Name="InputTextBox" Grid.Column="0" PlaceholderText="Say something…" KeyDown="OnInputKeyDown" />
            <Button Name="ClearButton" Grid.Column="1" Content="Clear" Margin="8,0,0,0" Click="OnClearClicked" />
            <Button Name="SendButton" Grid.Column="2" Content="Send" Margin="8,0,0,0" Click="OnSendClicked" />
        </Grid>

        <ScrollViewer Name="MessagesScrollViewer">
            <StackPanel Name="MessagesPanel" Spacing="8" />
        </ScrollViewer>
    </DockPanel>

</Window>
